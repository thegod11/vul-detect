            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/baseline/GTC/code",
            "args": [
                "CVEfixes"
            ]
        },

        {
            "name": "Python 调试程序: 当前vul-LMGNNs run.py文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "-cpg",
                "-embed",
                "-gtc",
                "-dataloaders",
                "save",
                "-train",
                "-path",
                "./data/model/my_best_vul_LMGGNN.pth"
            ]
        }
    ]
}